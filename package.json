{
  "name": "smart-lost-and-found",
  "private": true,
  "version": "1.0.0",
  "description": "Smart Lost & Found \u2013 College Campus Lost & Found Management System (React + Node.js/Express + MongoDB)",
  "keywords": [
    "react",
    "vite",
    "express",
    "nodejs",
    "mongodb",
    "mongoose",
    "rest-api",
    "lost-and-found",
    "college-project"
  ],
  "author": "madhusudhan1260",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev --prefix server\" \"vite\"",
    "dev:client": "vite",
    "dev:server": "npm run dev --prefix server",
    "setup": "npm install && npm install --prefix server && npm run seed --prefix server",
    "seed": "npm run seed --prefix server",
    "build": "vite build",
    "lint": "oxlint",
    "test": "node --test test/",
    "test:server": "npm test --prefix server",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "material-symbols": "^0.47.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
