# Copy this file to server/.env and change the values if needed.
PORT=5050
MONGODB_URI=mongodb://127.0.0.1:27017/smart_lost_found
# Use a long random string in production
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h
# The React dev server (allowed by CORS)
CLIENT_ORIGIN=http://localhost:5173
# Demo DOSS staff account created by `npm run seed`
DOSS_EMAIL=doss@college.edu
DOSS_PASSWORD=Doss@123
